# Copy to .env and export (or use docker compose --env-file .env). All values are optional.
LLM_PROVIDER=none            # none | anthropic | openai (any OpenAI-compatible server, e.g. Ollama)
LLM_MODEL=claude-sonnet-5-5  # for anthropic; for Ollama e.g. qwen2.5:7b
LLM_API_KEY=                 # or ANTHROPIC_API_KEY
LLM_BASE_URL=http://localhost:11434/v1   # openai-compatible servers only
LLM_POLISH=true              # let the LLM rephrase answers (verified before use)
EMBEDDER=auto                # auto | hashing | st
WHISPER_MODEL=small          # tiny | base | small | medium  (bigger = better Kannada, slower)
OCR_ENGINE=auto              # auto | tesseract | easyocr | none
SESSION_TTL_S=1800
RATE_LIMIT_PER_MIN=60
